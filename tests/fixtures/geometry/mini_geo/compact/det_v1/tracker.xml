<lccdd>
    <define>
        <constant name="InnerTracker_Barrel_radius_0" value="127*mm"/>
        <constant name="InnerTracker_Barrel_radius_1" value="400*mm"/>
        <constant name="Tracker_cooling_gap" value="5*mm"/> <!-- also defined in common/shared_constants.xml -->
    </define>

    <comment>Tracking detectors</comment>
    <detectors>
        <detector name="InnerTrackers" type="DD4hep_SubdetectorAssembly" vis="ITVis">
            <shape type="Polycone" material="Air">
                <zplane z="-10*mm" rmin="0" rmax="100*mm"/>
                <zplane z="+10*mm" rmin="0" rmax="100*mm"/>
            </shape>
            <!-- the composite shares its name with the detector below -->
            <composite name="InnerTrackerBarrel"/>
        </detector>
        <!-- a CAD model referenced by a local relative path: copied along as a resource -->
        <detector name="InnerTrackerSupportCAD" type="DD4hep_CAD_Assembly" vis="ITVis">
            <shape type="CAD_Assembly" ref="cad/support.stl" unit="mm"/>
        </detector>
    </detectors>

    <readouts>
        <readout name="InnerTrackerBarrelCollection">
            <id>${GlobalTrackerReadoutID}</id>
        </readout>
    </readouts>

    <detectors>
        <detector id="DetID_IT_Barrel" name="InnerTrackerBarrel" type="TrackerBarrel_o1_v06" readout="InnerTrackerBarrelCollection">
            <envelope vis="ITVis">
                <shape type="Assembly"/>
            </envelope>
            <comment>Silicon Inner Tracker Barrel</comment>

            <!-- every module carries a <sensor name="sensor">: the name repeats within this file -->
            <module name="InnerTrackerBarrelModule_01" vis="InnerTrackerModuleVis">
                <module_envelope width="30.1*mm" length="30.1*mm"/>
                <sensor name="sensor" thickness="0.050*mm"/>
                <include ref="module_down.xml"/>
            </module>
            <module name="InnerTrackerBarrelModule_02" vis="InnerTrackerModuleVis">
                <module_envelope width="30.1*mm" length="60.2*mm"/>
                <sensor name="sensor" thickness="0.075*mm"/>
                <include ref="module_up.xml"/>
            </module>

            <layer module="InnerTrackerBarrelModule_01" id="0" type="1" >
                <rphi_layout phi_tilt="0*deg" nphi="14*2" phi0="0" rc="InnerTracker_Barrel_radius_0" dr="2.5*mm"/>
                <z_layout dr="0" z0="InnerTracker_Barrel_half_length_0-15.05*mm" nz="32"/>
            </layer>
            <layer module="InnerTrackerBarrelModule_02" id="1" >
                <rphi_layout phi_tilt="0*deg" nphi="43*2" phi0="0" rc="InnerTracker_Barrel_radius_1" dr="2.5*mm"/>
                <z_layout dr="0" z0="InnerTracker_Barrel_half_length_1-15.05*mm" nz="32"/>
            </layer>
        </detector>
    </detectors>
</lccdd>
